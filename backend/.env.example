# CMMC Ready configuration. All settings are environment variables.
# Locally: run `python -m cmmcready create-admin` to write backend/.env (git-ignored).
# Hosted: set these in your provider's environment settings.

# --- Login (required unless guest mode is on: without these the API refuses all requests;
# in demo mode, where guests are on by default, visitors browse read-only and nobody can log in) ---
CMMCREADY_ADMIN_USER=admin
# PBKDF2 hash produced by create-admin. Never put a plain password here.
CMMCREADY_ADMIN_PASSWORD_HASH=pbkdf2_sha256:600000:<salt>:<hash>
# At least 32 random characters. Changing it logs everyone out.
CMMCREADY_SECRET_KEY=<random>
# HTTPS-only session cookie. Default true; false only for local http://localhost.
CMMCREADY_COOKIE_SECURE=false
# Trust X-Forwarded-For for the client IP (only behind a proxy you control).
CMMCREADY_TRUST_PROXY=false
# Session length in hours (default 8)
CMMCREADY_SESSION_HOURS=8

# --- Storage and limits (optional) ---
# SQLite database file (default: backend/data/cmmcready.db)
CMMCREADY_DB=data/cmmcready.db
# Maximum upload size for collector files, in MB (default: 10)
CMMCREADY_MAX_UPLOAD_MB=10

# --- Demo and guest mode (optional) ---
# Demo mode: guests on by default and the fictional demo organization is loaded.
# CMMCREADY_DEMO=false
# Read-only guest access for anonymous visitors (default: on in demo mode, off otherwise)
# CMMCREADY_GUEST=false
